# ── Local Development ───────────────────────────────────────
PORT=5000

# Option A: direct URI (local mongo or docker-compose)
MONGODB_URI=mongodb://localhost:27017/quickbite

# Option B: individual vars (used by ECS/Copilot in production)
# MONGO_HOST=mongodb.production.quickbite.local
# MONGO_PORT=27017
# MONGO_DB=quickbite
# MONGO_USERNAME=quickbite_user
# MONGO_PASSWORD=strongpassword

JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000
NODE_ENV=development
